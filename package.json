{
  "name": "easyslip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Receipt-led accounting workspace for Hong Kong SMEs.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@auth/sveltekit": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1170.0",
    "@sveltejs/adapter-node": "^5.5.8",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "postgres": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3",
    "unpdf": "^1.9.1",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "svelte-check": "^4.7.8",
    "vitest": "^5.1.0"
  }
}
