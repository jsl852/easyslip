# Copy to .env and replace every value. Never commit .env.

# PostgreSQL connection string. Local docker-compose default:
# DATABASE_URL=postgres://easyslip:easyslip@127.0.0.1:5432/easyslip
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/easyslip

# Set to require on Render. Leave unset for a local database without TLS.
# DATABASE_SSL=require

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
# Public origin, no path. Local: http://localhost:5173
# Render: https://your-service.onrender.com
AUTH_URL=http://localhost:5173
AUTH_TRUST_HOST=true

# Production Node process only. `npm run dev` uses the real request URL.
# ORIGIN=http://127.0.0.1:4173
# BODY_SIZE_LIMIT=80M

# Google OIDC. Leave blank to hide Google sign-in.
# Authorized redirect URI: {AUTH_URL}/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local-only password sign-in. Do not enable on Render.
# AUTH_DEV_LOGIN=true
# DEV_LOGIN_PASSWORD=replace-with-a-local-password

# xAI OpenAI-compatible API. Leave blank to use the marked manual fallback.
XAI_API_KEY=
# XAI_MODEL=grok-4-fast
# XAI_API_BASE=https://api.x.ai/v1

# Private object storage for new receipt files and workbooks. Leave all four
# variables unset to store file bytes in Postgres. Do not commit real keys.
# The bucket must block public access. Set all four, or none.
#
# Amazon S3:
# AWS_REGION=us-west-2
# S3_BUCKET=your-private-bucket
# AWS_ACCESS_KEY_ID=replace-with-an-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-a-secret
#
# Cloudflare R2 uses the same four variables. Set AWS_REGION=auto and S3_ENDPOINT
# to the account endpoint. AWS_ENDPOINT_URL is an alias; prefer S3_ENDPOINT.
# S3_ENDPOINT alone does not enable storage.
# AWS_REGION=auto
# S3_BUCKET=your-private-bucket
# AWS_ACCESS_KEY_ID=replace-with-an-r2-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-an-r2-secret
# S3_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com
